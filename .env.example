# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables.
# Without a key the app still works: the rotation model answers without AI.
OPENROUTER_API_KEY=
# Optional. Defaults to "openrouter/auto". Pick a fast model that supports JSON output.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
NEXT_PUBLIC_SITE_URL=
# Development without internet ONLY: 1 = sample data (shown as "Sample data" in the header). Never in production.
MOCK_DATA=
