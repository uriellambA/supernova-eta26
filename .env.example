# Copiar a .env.local (local) o cargar en Vercel → Settings → Environment Variables.
# Sin clave, la app funciona igual: la recomendación usa solo el motor de reglas.
OPENROUTER_API_KEY=
# Opcional. Por defecto "openrouter/auto". Elegir un modelo rápido que soporte JSON.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
# Opcional: URL pública (se envía a OpenRouter como HTTP-Referer)
NEXT_PUBLIC_SITE_URL=
# SOLO desarrollo sin internet: 1 = datos SIMULADOS (la app lo avisa en pantalla). Nunca en producción.
MOCK_DATA=
